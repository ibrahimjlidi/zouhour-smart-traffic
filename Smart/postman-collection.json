            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('token', pm.response.json().token);",
                  "  console.log('Token saved: ' + pm.response.json().token);",
                  "}"
                ]
